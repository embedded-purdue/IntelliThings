# Tracked defaults for the IntelliThings demo master. NO SECRETS HERE —
# Wi-Fi and MQTT credentials go in sdkconfig.local (gitignored) or menuconfig.

CONFIG_IDF_TARGET="esp32c3"

# LuatOS ESP32-C3 Core: 4 MB SPI flash, DIO mode
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The broker is plain MQTT on the LAN (mqtt://); drop the TLS and WebSocket transports.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

# Send the first NTP request as soon as Wi-Fi is up.
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# Sockets: 1 MQTT connection + 3 used by httpd internally + 8 browser clients (the booth
# monitor, admin phones, idle keep-alives).
CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Keep the Wi-Fi driver's code in flash instead of RAM (more heap; no need for full throughput).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
