# Copy to .env and fill in. NEVER commit the real .env.

# --- Wi-Fi (firmware) ---
WIFI_SSID=
WIFI_PASSWORD=

# --- MQTT broker (Pi 5 hub) ---
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# --- Home Assistant ---
HA_BASE_URL=http://127.0.0.1:8123
HA_LONG_LIVED_TOKEN=

# --- Cloud LLM ---
LLM_API_KEY=
LLM_MODEL=

# --- Planned OpenRouter integration (not active yet) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
