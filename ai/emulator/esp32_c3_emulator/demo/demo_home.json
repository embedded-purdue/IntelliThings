    {"name": "Kitchen fire hazard", "group": "hazard", "set": {"home.time_of_day": "evening", "home.anyone_home": true, "kitchen.presence": false, "kitchen.temperature_c": 37, "kitchen.pm2_5_ugm3": 280, "kitchen.voc_index": 490, "kitchen.co2_ppm": 2600, "living_room.presence": true}},
    {"name": "Car running in a closed garage", "group": "hazard", "set": {"home.time_of_day": "morning", "home.anyone_home": true, "garage.car": "running", "garage.door_open": false, "garage.presence": true, "garage.light_on": true}},
    {"name": "Mould risk in the bedroom", "group": "hazard", "set": {"home.time_of_day": "morning", "home.anyone_home": true, "master_bedroom.humidity_pct": 82, "master_bedroom.window_open": false, "master_bedroom.temperature_c": 22}},
    {"name": "Smoke in the bedroom at night", "group": "hazard", "set": {"home.time_of_day": "night", "home.anyone_home": true, "master_bedroom.presence": true, "master_bedroom.pm2_5_ugm3": 240, "master_bedroom.voc_index": 450}},
