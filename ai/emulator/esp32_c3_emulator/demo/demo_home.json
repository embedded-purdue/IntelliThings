    {"name": "Someone in the kitchen while away", "group": "security", "set": {"home.time_of_day": "afternoon", "home.anyone_home": false, "home.front_door_locked": true, "kitchen.presence": true, "kitchen.light_on": false}},
    {"name": "Garden motion at night", "group": "security", "set": {"home.time_of_day": "night", "home.anyone_home": true, "master_bedroom.presence": true, "garden.motion": true, "patio.light_on": false}},

    {"name": "Lights on in empty rooms", "group": "energy", "set": {"home.time_of_day": "afternoon", "home.anyone_home": false, "living_room.presence": false, "living_room.light_on": true, "kitchen.presence": false, "kitchen.light_on": true}},
    {"name": "Sprinkler running in the rain", "group": "energy", "set": {"home.time_of_day": "morning", "home.anyone_home": true, "outside.condition": "rain", "garden.sprinkler_on": true, "garden.soil_moisture_pct": 55}},
    {"name": "Window open, heating on", "group": "energy", "set": {"home.time_of_day": "evening", "home.anyone_home": true, "outside.temperature_c": 2, "living_room.window_open": true, "living_room.presence": true, "living_room.temperature_c": 23.5}},
    {"name": "All lights on at noon", "group": "energy", "set": {"home.time_of_day": "afternoon", "home.anyone_home": true, "outside.condition": "clear", "living_room.presence": true, "living_room.light_on": true, "kitchen.presence": false, "kitchen.light_on": true, "master_bedroom.presence": false, "master_bedroom.light_on": true}},
