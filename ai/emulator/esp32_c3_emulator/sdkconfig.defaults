# Tracked defaults for the IntelliThings emulator. NO SECRETS HERE —
# Wi-Fi and MQTT credentials go in sdkconfig.local (gitignored) or menuconfig.

CONFIG_IDF_TARGET="esp32c3"

# LuatOS ESP32-C3 Core: 4 MB SPI flash, DIO mode
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# Two 1.9 MB app slots (partitions.csv): room to grow, and later an in-place fallback to
# the previous firmware. Changing the table needs a full flash (idf.py flash), not app-flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Optimise for size; v0.1.0 was built with the debug default (-Og).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The broker is plain MQTT on the LAN (mqtt://); drop the TLS and WebSocket transports.
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

# Resolve homeassistant.local (mDNS) when connecting to the broker
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# Send the first NTP request as soon as Wi-Fi is up. With the default random delay, the
# four MQTT clients' broker lookups can take all four lwIP DNS request slots first (each
# failed mDNS lookup holds one for ~7 s), so SNTP never resolves while the broker is down.
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# Sockets: 4 MQTT connections + 3 used by httpd internally + 7 panel clients (httpd's
# max_open_sockets) = 14. With the default 10, idle browser keep-alive connections exhausted
# lwIP before httpd's LRU purge could kick in, and the panel stopped accepting connections.
CONFIG_LWIP_MAX_SOCKETS=16

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
